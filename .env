BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=b603b7efe9963c7516c1578a79d2dcf83d1fbea4b2c0c65690d9778d547416fd
FORMS_INTERNAL_URL=http://localhost:3001
BETTER_AUTH_INTERNAL_URL=http://localhost:3000
BETTER_AUTH_URL=http://179.197.232.97:8080
BETTER_AUTH_TRUSTED_ORIGINS=http://179.197.232.97:8080

# Mercado Pago Checkout Pro (Orders API)
# Estes URLs são usados em redirects OAuth,
# no retorno do Checkout Pro e na URL de notificações/webhook
APP_PUBLIC_URL=https://www.seu-dominio.com.br

# Credenciais da aplicação criada em Suas integrações no Mercado Pago.
# Crie a aplicação em uma conta de desenvolvedor separada e informe esta URL
# exatamente em Redirect URLs: ${APP_PUBLIC_URL}/api/admin/mercadopago/callback
# Habilite PKCE Authorization Code nas configurações da aplicação
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# true para conectar um usuário/conta de teste e receber tokens TEST de sandbox;
# false para a conta real e recebimentos em produção.
MERCADOPAGO_TEST_MODE=false

# ID numérico da conta Mercado Pago da ASPAN que deve receber as doações.
# No modo de teste, use aqui o ID da conta vendedora de teste correspondente.
# O painel recusa autorizações que pertençam a outra conta.
MERCADOPAGO_ASPAN_SELLER_ID=

# Segredo de assinatura encontrado em Suas integrações > Webhooks.
# Configure o evento Orders v2 para enviar notificações para:
# ${APP_PUBLIC_URL}/api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_SECRET=

# Chave aleatória de 32 bytes codificada em Base64 para cifrar access/refresh tokens
# no banco. Gere uma chave exclusiva por ambiente com: openssl rand -base64 32
# Guarde-a no gerenciador de segredos do servidor; perdê-la exige reconectar o MP.
MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
